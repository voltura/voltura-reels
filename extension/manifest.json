{
  "manifest_version": 3,
  "name": "Voltura Reel Player",
  "version": "1.1.1",
  "minimum_chrome_version": "120",
  "description": "Watch Facebook Reels and video or photo Stories fullscreen.",
  "homepage_url": "https://reels.voltura.se/",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://www.facebook.com/*", "https://facebook.com/*", "https://*.fbcdn.net/*"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Voltura Reel Player settings",
    "default_popup": "settings.html",
    "default_icon": {
      "16": "icons/16.png",
      "24": "icons/24.png",
      "32": "icons/32.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://facebook.com/*"],
      "js": ["content.js"],
      "css": ["facebook.css"],
      "run_at": "document_idle"
    }
  ]
}
